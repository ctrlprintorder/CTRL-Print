        "phone": { "type": "string" },
        "address": { "type": "string" },
        "bank": { "type": "string" },
        "paymentMethods": { "type": "string" },
        "tnc": { "type": "string" },
        "user": { "type": "string" },
        "pass": { "type": "string" }
      }
    },
